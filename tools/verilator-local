#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
prefix=${NSCSCC_VERILATOR_PREFIX:-$script_dir/.local/verilator/5.020}
launcher=$prefix/bin/verilator
backend=$prefix/bin/verilator_bin
expected_launcher_sha256=59a001ed47f9cccfa1b13acb503708f627b65f523667bdbaddbae9db7b8252b1
expected_backend_sha256=e797e5143f623d3d5a5776e7a5ab1b483ff71e4eb26d73dd7a404c6a9dbee8e7

if [ ! -x "$launcher" ] || [ ! -x "$backend" ]; then
    printf 'locked Verilator 5.020 is missing below %s\n' "$prefix" >&2
    printf 'restore the validated tools/.local cache before running CPU gates\n' >&2
    exit 127
fi

actual_launcher_sha256=$(sha256sum "$launcher" | awk '{print $1}')
actual_backend_sha256=$(sha256sum "$backend" | awk '{print $1}')
if [ "$actual_launcher_sha256" != "$expected_launcher_sha256" ]; then
    printf 'unexpected Verilator launcher hash: expected %s, found %s\n' \
        "$expected_launcher_sha256" "$actual_launcher_sha256" >&2
    exit 1
fi
if [ "$actual_backend_sha256" != "$expected_backend_sha256" ]; then
    printf 'unexpected Verilator backend hash: expected %s, found %s\n' \
        "$expected_backend_sha256" "$actual_backend_sha256" >&2
    exit 1
fi

unset VERILATOR_ROOT
exec "$launcher" "$@"
