diff --git a/scripts/env/doctor.py b/scripts/env/doctor.py
index d2a3404..57dddeb 100755
--- a/scripts/env/doctor.py
+++ b/scripts/env/doctor.py
@@ -33,6 +33,14 @@ def root_gitlink(root: Path, path: str) -> str | None:
     return fields[1]
 
 
+def executable_file(path: Path) -> bool:
+    if not path.is_file():
+        return False
+    if path.suffix.lower() in {".bat", ".cmd", ".exe"}:
+        return True
+    return os.access(path, os.X_OK)
+
+
 def main() -> int:
     parser = argparse.ArgumentParser(description="只读检查本机环境和嵌套仓库")
     parser.add_argument("--require", action="append", default=[], choices=("sim", "vivado", "linux", "board"))
@@ -96,7 +104,7 @@ def main() -> int:
     print(f"[{'通过' if code == 0 else '警告'}] Docker 镜像: {image}")
 
     vivado = Path(os.environ.get("VIVADO", "/opt/Xilinx/Vivado/2023.2/bin/vivado"))
-    vivado_ok = vivado.is_file() and os.access(vivado, os.X_OK)
+    vivado_ok = executable_file(vivado)
     print(f"[{'通过' if vivado_ok else ('失败' if 'vivado' in required else '警告')}] Vivado: {vivado}")
     failures += int("vivado" in required and not vivado_ok)
 
diff --git a/scripts/env/run-in-container b/scripts/env/run-in-container
index c1c74d9..694a6f3 100755
--- a/scripts/env/run-in-container
+++ b/scripts/env/run-in-container
@@ -1,4 +1,4 @@
-#!/usr/bin/env sh
+#!/usr/bin/env bash
 set -eu
 
 script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
@@ -12,23 +12,69 @@ workdir=${CONTAINER_WORKDIR:-$workspace_root}
   exit 2
 }
 
-host_uid=$(id -u)
-host_gid=$(id -g)
-docker run --rm --user 0 -v "$cache_volume:/cache" "$image" sh -ec \
-  'mkdir -p /cache/sbt /cache/ivy; chown "$1:$2" /cache /cache/sbt /cache/ivy' sh \
-  "$host_uid" "$host_gid"
+host_windows=0
+case "$(uname -s 2>/dev/null || true)" in
+  MINGW*|MSYS*|CYGWIN*) host_windows=1 ;;
+esac
 
-exec docker run --rm -i \
-  --user "$host_uid:$host_gid" \
+container_root=$workspace_root
+container_workdir=$workdir
+spinal_workspace_root=${SPINAL_SIM_WORKSPACE_ROOT:-$workspace_root/cpu/target/spinal-sim/workspaces}
+spinal_workspace=${SPINAL_SIM_WORKSPACE:-$workspace_root/cpu/target/spinal-sim/contracts}
+docker_workspace_mount="$workspace_root:$workspace_root"
+mapped_args=("$@")
+
+map_to_container() {
+  case "$1" in
+    "$workspace_root") printf '%s\n' "$container_root" ;;
+    "$workspace_root"/*) printf '%s/%s\n' "$container_root" "${1#"$workspace_root"/}" ;;
+    *) printf '%s\n' "$1" ;;
+  esac
+}
+
+if [ "$host_windows" -eq 1 ]; then
+  command -v cygpath >/dev/null 2>&1 || {
+    printf 'Windows Git Bash 需要 cygpath\n' >&2
+    exit 127
+  }
+  export MSYS_NO_PATHCONV=1
+  container_root=/workspace
+  container_workdir=$(map_to_container "$workdir")
+  spinal_workspace_root=$(map_to_container "$spinal_workspace_root")
+  spinal_workspace=$(map_to_container "$spinal_workspace")
+  docker_workspace_mount="$(cygpath -m "$workspace_root"):$container_root"
+  mapped_args=()
+  for argument in "$@"; do
+    mapped_args+=("$(map_to_container "$argument")")
+  done
+fi
+
+if [ "$host_windows" -eq 0 ]; then
+  host_uid=$(id -u)
+  host_gid=$(id -g)
+  docker run --rm --user 0 -v "$cache_volume:/cache" "$image" sh -ec \
+    'mkdir -p /cache/sbt /cache/ivy; chown "$1:$2" /cache /cache/sbt /cache/ivy' sh \
+    "$host_uid" "$host_gid"
+else
+  docker run --rm --user 0 -v "$cache_volume:/cache" "$image" sh -ec \
+    'mkdir -p /cache/sbt /cache/ivy'
+fi
+
+docker_args=(docker run --rm -i)
+if [ "$host_windows" -eq 0 ]; then
+  docker_args+=(--user "$host_uid:$host_gid")
+fi
+
+exec "${docker_args[@]}" \
   -e HOME=/tmp \
   -e LANG=C.UTF-8 \
   -e LC_ALL=C.UTF-8 \
   -e FORCE_COLOR="${FORCE_COLOR:-0}" \
   -e NO_COLOR="${NO_COLOR:-}" \
   -e COURSIER_CACHE=/cache/coursier \
-  -e SPINAL_SIM_WORKSPACE_ROOT="${SPINAL_SIM_WORKSPACE_ROOT:-$workspace_root/cpu/target/spinal-sim/workspaces}" \
-  -e SPINAL_SIM_WORKSPACE="${SPINAL_SIM_WORKSPACE:-$workspace_root/cpu/target/spinal-sim/contracts}" \
-  -v "$workspace_root:$workspace_root" \
+  -e SPINAL_SIM_WORKSPACE_ROOT="$spinal_workspace_root" \
+  -e SPINAL_SIM_WORKSPACE="$spinal_workspace" \
+  -v "$docker_workspace_mount" \
   -v "$cache_volume:/cache" \
-  -w "$workdir" \
-  "$image" "$@"
+  -w "$container_workdir" \
+  "$image" "${mapped_args[@]}"
diff --git a/scripts/vivado/implement.sh b/scripts/vivado/implement.sh
index c29fb0c..338137b 100755
--- a/scripts/vivado/implement.sh
+++ b/scripts/vivado/implement.sh
@@ -11,16 +11,49 @@ version=$3
 build_dir=$(realpath -m "$4")
 vivado=${VIVADO:-/opt/Xilinx/Vivado/2023.2/bin/vivado}
 mhz=${PERF_CPU_MHZ:-100}
+vivado_windows=0
+case "${vivado,,}" in
+  *.bat|*.cmd|*.exe) vivado_windows=1 ;;
+esac
 
 case "$build_dir" in
   "$workspace"/build/*) ;;
   *) printf 'Vivado 输出必须位于 %s/build: %s\n' "$workspace" "$build_dir" >&2; exit 2 ;;
 esac
-[[ -x $vivado ]] || { printf 'Vivado 不可执行: %s\n' "$vivado" >&2; exit 127; }
+if (( vivado_windows )); then
+  [[ -f $vivado ]] || { printf 'Vivado 不存在: %s\n' "$vivado" >&2; exit 127; }
+else
+  [[ -x $vivado ]] || { printf 'Vivado 不可执行: %s\n' "$vivado" >&2; exit 127; }
+fi
 [[ -f $workspace/build/rtl/mycpu_top.v ]] || {
   printf '缺少发布 RTL，请先运行 make cpu-generate\n' >&2; exit 1;
 }
 
+run_vivado() {
+  local argument
+  local -a native_args=()
+  if (( vivado_windows )); then
+    command -v cygpath >/dev/null 2>&1 || {
+      printf 'Windows Vivado 需要 Git Bash 的 cygpath\n' >&2
+      exit 127
+    }
+    for argument in "$@"; do
+      if [[ $argument == /* ]]; then
+        native_args+=("$(cygpath -w "$argument")")
+      else
+        native_args+=("$argument")
+      fi
+    done
+  else
+    native_args=("$@")
+  fi
+  if [[ ${vivado,,} == *.bat || ${vivado,,} == *.cmd ]]; then
+    cmd.exe /d /c "$(cygpath -w "$vivado")" "${native_args[@]}"
+  else
+    "$vivado" "${native_args[@]}"
+  fi
+}
+
 rm -rf -- "$build_dir"
 mkdir -p "$build_dir"
 (cd "$chiplab" && tar --exclude='.git' --exclude='*/.git' -cf - .) |
@@ -40,19 +73,19 @@ if [[ $build_dir == *func* ]]; then
 else
   sed -i '2s|.*|// `define RUN_FUNC_TEST|' "$config"
   sed -i '3s|.*|`define RUN_PERF_TEST|' "$config"
-  "$vivado" -mode batch -source "$run_dir/generate_perf_pll.tcl" \
+  run_vivado -mode batch -source "$run_dir/generate_perf_pll.tcl" \
     -tclargs "$mhz" "$build_dir/chip/soc_demo/nscscc-team/xilinx_ip/clk_pll/clk_pll.xci" \
     "$run_dir/perf_clock_generated.txt"
 fi
 
 (
   cd "$run_dir"
-  "$vivado" -mode batch -source create_project.tcl
-  "$vivado" -mode batch -source bit.tcl -tclargs "$mode" "$mhz"
+  run_vivado -mode batch -source create_project.tcl
+  run_vivado -mode batch -source bit.tcl -tclargs "$mode" "$mhz"
 )
 
 impl_dir="$run_dir/project/loongson.runs/impl_1"
-"$vivado" -mode batch -source "$workspace/scripts/vivado/report_impl.tcl" \
+run_vivado -mode batch -source "$workspace/scripts/vivado/report_impl.tcl" \
   -tclargs "$impl_dir/soc_top_routed.dcp" "$impl_dir"
 
 printf 'Vivado 完成: mode=%s requested_mhz=%s build=%s\n' "$mode" "$mhz" "$build_dir"
