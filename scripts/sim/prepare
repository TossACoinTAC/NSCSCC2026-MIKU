#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: sim-prepare --workspace DIR [--artifact-root DIR] --cpu-dir DIR --chiplab-dir DIR' \
    '                   --chiplab-commit HASH --profile clean|instrumented' \
    '                   --suite standard|func58|perf20 --workloads CSV' \
    '                   --config-args STRING --jobs N --sim-path PATH' \
    '                   --verilator-home DIR --extra-libs STRING [--rebuild 0|1]'
}

workspace=
artifact_root=
cpu_dir=
chiplab_dir=
chiplab_commit=
profile=
suite=
workloads=
config_args=
jobs=
sim_path=
verilator_home=
extra_libs=
rebuild=0

while (($#)); do
  case "$1" in
    --workspace) workspace=$2; shift 2 ;;
    --artifact-root) artifact_root=$2; shift 2 ;;
    --cpu-dir) cpu_dir=$2; shift 2 ;;
    --chiplab-dir) chiplab_dir=$2; shift 2 ;;
    --chiplab-commit) chiplab_commit=$2; shift 2 ;;
    --profile) profile=$2; shift 2 ;;
    --suite) suite=$2; shift 2 ;;
    --workloads) workloads=$2; shift 2 ;;
    --config-args) config_args=$2; shift 2 ;;
    --jobs) jobs=$2; shift 2 ;;
    --sim-path) sim_path=$2; shift 2 ;;
    --verilator-home) verilator_home=$2; shift 2 ;;
    --extra-libs) extra_libs=$2; shift 2 ;;
    --rebuild) rebuild=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z $artifact_root ]]; then
  artifact_root="$workspace/build/sim"
fi
for value in workspace cpu_dir chiplab_dir chiplab_commit profile suite workloads config_args jobs sim_path verilator_home; do
  if [[ -z ${!value} ]]; then
    printf 'missing required value: %s\n' "$value" >&2
    exit 2
  fi
done
if [[ $profile != clean && $profile != instrumented ]]; then
  printf 'SIM_PROFILE must be clean or instrumented, got %s\n' "$profile" >&2
  exit 2
fi
if [[ $suite != standard && $suite != func58 && $suite != perf20 ]]; then
  printf 'SIM_SUITE must be standard, func58, or perf20, got %s\n' "$suite" >&2
  exit 2
fi
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
  printf 'jobs must be a positive integer, got %s\n' "$jobs" >&2
  exit 2
fi
if [[ ! $rebuild =~ ^[01]$ ]]; then
  printf 'SIM_REBUILD must be 0 or 1, got %s\n' "$rebuild" >&2
  exit 2
fi
workspace=$(realpath -m "$workspace")
artifact_root=$(realpath -m "$artifact_root")
cpu_dir=$(realpath -m "$cpu_dir")
chiplab_dir=$(realpath -m "$chiplab_dir")

hash_stream() {
  sha256sum | awk '{print $1}'
}

manifest_value() {
  local key=$1
  local file=$2
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$file"
}

remove_cache_entry() {
  local target=$1
  [[ -e $target || -L $target ]] || return 0
  chmod -R u+w "$target" 2>/dev/null || true
  rm -rf -- "$target"
}

replace_cache_entry() {
  local staging=$1
  local target=$2
  remove_cache_entry "$target"
  mv "$staging" "$target"
}

record_hash() {
  local label=$1
  local file=$2
  printf '%s=%s\n' "$label" "$(sha256sum "$file" | awk '{print $1}')"
}

root_commit=$(git -C "$workspace" rev-parse HEAD)
cpu_source_sha=$(python3 "$workspace/scripts/common/content_hash.py" "$cpu_dir")
cpu_short=${cpu_source_sha:0:12}
chiplab_head=$(git -C "$chiplab_dir" rev-parse HEAD)
if [[ $chiplab_head != "$chiplab_commit" ]]; then
  printf 'Chiplab HEAD %s does not match locked commit %s\n' "$chiplab_head" "$chiplab_commit" >&2
  exit 1
fi
rtl="$workspace/build/rtl/mycpu_top.v"
if [[ ! -f $rtl ]]; then
  printf 'generated RTL is missing: %s\n' "$rtl" >&2
  exit 1
fi
rtl_sha=$(sha256sum "$rtl" | awk '{print $1}')

cache_root="$artifact_root/cache"
mkdir -p "$cache_root/platforms" "$cache_root/models" "$cache_root/software" \
  "$cache_root/locks" "$artifact_root/prepared"
tmp_dirs=()
cleanup() {
  local directory
  for directory in "${tmp_dirs[@]}"; do
    if [[ -e $directory ]]; then
      chmod -R u+w "$directory" 2>/dev/null || true
      rm -rf -- "$directory"
    fi
  done
}
trap cleanup EXIT

# The platform cache contains only the clean, locked Chiplab tree.  It is never
# configured or built in place, so local harness edits remain evidence rather
# than an accidental model input.
platform_key=$(printf 'format=nscscc-sim-platform-v1\nchiplab_commit=%s\n' "$chiplab_commit" | hash_stream)
platform_dir="$cache_root/platforms/$platform_key"
platform_manifest="$platform_dir/platform-manifest.txt"
exec {platform_lock_fd}>"$cache_root/locks/platform-$platform_key.lock"
flock "$platform_lock_fd"
platform_valid=0
if [[ -f $platform_manifest && -f $platform_dir/.complete ]] &&
   [[ $(manifest_value format "$platform_manifest") == nscscc-sim-platform-v1 ]] &&
   [[ $(manifest_value platform_key "$platform_manifest") == "$platform_key" ]] &&
   [[ $(manifest_value chiplab_commit "$platform_manifest") == "$chiplab_commit" ]]; then
  platform_valid=1
fi
if [[ $rebuild == 1 || $platform_valid == 0 ]]; then
  platform_staging=$(mktemp -d "$cache_root/platforms/.${platform_key}.XXXXXX")
  tmp_dirs+=("$platform_staging")
  mkdir -p "$platform_staging/source"
  git -C "$chiplab_dir" archive "$chiplab_commit" | tar -xf - -C "$platform_staging/source"
  ln -s /opt/nscscc/toolchains "$platform_staging/source/toolchains"
  cat > "$platform_staging/platform-manifest.txt" <<EOF
format=nscscc-sim-platform-v1
platform_key=$platform_key
chiplab_commit=$chiplab_commit
EOF
  touch "$platform_staging/.complete"
  find -P "$platform_staging" ! -type l -exec chmod a-w {} +
  replace_cache_entry "$platform_staging" "$platform_dir"
  tmp_dirs[-1]=
  printf 'platform cache miss: %s\n' "$platform_key"
else
  printf 'platform cache hit: %s\n' "$platform_key"
fi
flock -u "$platform_lock_fd"

patch_file="$workspace/scripts/sim/difftest-interrupt-memory-order.patch"
patch_lock="$patch_file.sha256"
m01_patch_file="$workspace/scripts/sim/m01-perf-monitor.patch"
m01_patch_lock="$m01_patch_file.sha256"
m01_source_lock="$workspace/scripts/sim/manifest.sha256"
official_patch_file="$workspace/scripts/sim/official-software-switch.patch"
official_patch_lock="$official_patch_file.sha256"
simulation_patch_file="$workspace/scripts/sim/confreg-simulation-mode.patch"
simulation_patch_lock="$simulation_patch_file.sha256"

(cd "$workspace" && sha256sum -c "$simulation_patch_lock")
simulation_patch_sha=$(sha256sum "$simulation_patch_file" | awk '{print $1}')
patch_sha=none
m01_patch_sha=none
m01_source_sha=none
official_patch_sha=none
if [[ $suite != standard ]]; then
  (cd "$workspace" && sha256sum -c "$official_patch_lock")
  official_patch_sha=$(sha256sum "$official_patch_file" | awk '{print $1}')
fi
if [[ $profile == instrumented ]]; then
  (cd "$workspace" && sha256sum -c "$patch_lock")
  (cd "$workspace" && sha256sum -c "$m01_patch_lock")
  (cd "$workspace" && sha256sum -c "$m01_source_lock")
  patch_sha=$(sha256sum "$patch_file" | awk '{print $1}')
  m01_patch_sha=$(sha256sum "$m01_patch_file" | awk '{print $1}')
  m01_source_sha=$(sha256sum "$m01_source_lock" | awk '{print $1}')
fi

verilator_bin=$(env PATH="$sim_path:$PATH" sh -c 'command -v verilator')
verilator_version=$(PATH="$sim_path:$PATH" verilator --version | head -n 1)
verilator_sha=$(sha256sum "$verilator_bin" | awk '{print $1}')
cxx_bin=$(command -v g++)
cxx_version=$(g++ --version | head -n 1)
cxx_sha=$(sha256sum "$cxx_bin" | awk '{print $1}')
config_args_sha=$(printf '%s' "$config_args" | hash_stream)
extra_libs_sha=$(printf '%s' "$extra_libs" | hash_stream)
model_key=$({
  printf 'format=nscscc-sim-model-v1\n'
  printf 'platform_key=%s\nrtl_sha256=%s\nprofile=%s\nsuite=%s\n' \
    "$platform_key" "$rtl_sha" "$profile" "$suite"
  printf 'config_args_sha256=%s\nextra_libs_sha256=%s\n' "$config_args_sha" "$extra_libs_sha"
  printf 'simulation_patch_sha256=%s\nofficial_patch_sha256=%s\n' \
    "$simulation_patch_sha" "$official_patch_sha"
  printf 'instrumentation_patch_sha256=%s\nm01_patch_sha256=%s\nm01_source_sha256=%s\n' \
    "$patch_sha" "$m01_patch_sha" "$m01_source_sha"
  printf 'verilator_sha256=%s\nverilator_version=%s\nverilator_home=%s\n' \
    "$verilator_sha" "$verilator_version" "$verilator_home"
  printf 'cxx_sha256=%s\ncxx_version=%s\n' "$cxx_sha" "$cxx_version"
} | hash_stream)
model_dir="$cache_root/models/$model_key"
model_manifest="$model_dir/model-manifest.txt"
model="$model_dir/sims/verilator/run_prog/output"
exec {model_lock_fd}>"$cache_root/locks/model-$model_key.lock"
flock "$model_lock_fd"
model_valid=0
if [[ -f $model_manifest && -x $model ]] &&
   [[ $(manifest_value format "$model_manifest") == nscscc-sim-model-v1 ]] &&
   [[ $(manifest_value model_key "$model_manifest") == "$model_key" ]] &&
   [[ $(manifest_value model_sha256 "$model_manifest") == "$(sha256sum "$model" | awk '{print $1}')" ]]; then
  model_valid=1
fi
if [[ $rebuild == 1 || $model_valid == 0 ]]; then
  model_staging=$(mktemp -d "$cache_root/models/.${model_key}.XXXXXX")
  tmp_dirs+=("$model_staging")
  cp -a --reflink=auto "$platform_dir/source/." "$model_staging"
  chmod -R u+w "$model_staging"
  rm -rf -- "$model_staging/IP/myCPU"
  mkdir -p "$model_staging/IP/myCPU"
  install -m 0444 "$rtl" "$model_staging/IP/myCPU/mycpu_top.v"
  export CHIPLAB_HOME="$model_staging"

  TMPDIR=/tmp patch --no-backup-if-mismatch -d "$model_staging" -p1 --forward --batch < "$simulation_patch_file"
  if [[ $suite != standard ]]; then
    TMPDIR=/tmp patch --no-backup-if-mismatch -d "$model_staging" -p1 --forward --batch < "$official_patch_file"
  fi
  if [[ $profile == instrumented ]]; then
    TMPDIR=/tmp patch --no-backup-if-mismatch -d "$model_staging" -p1 --forward --batch < "$patch_file"
    install -m 0444 "$workspace/scripts/sim/perf_monitor.h" \
      "$model_staging/sims/verilator/testbench/include/perf_monitor.h"
    install -m 0444 "$workspace/scripts/sim/perf_monitor.cpp" \
      "$model_staging/sims/verilator/testbench/perf_monitor.cpp"
    TMPDIR=/tmp patch --no-backup-if-mismatch -d "$model_staging" -p1 --forward --batch < "$m01_patch_file"
    if ! awk '
      previous == "    top = new Vtop;" &&
        $0 == "    perf_monitor = new PerfMonitor(top);" { found = 1 }
      { previous = $0 }
      END { exit !found }
    ' "$model_staging/sims/verilator/testbench/testbench.cpp"; then
      printf '%s\n' \
        'M01 patch did not initialize PerfMonitor immediately after Vtop construction' >&2
      exit 1
    fi
  fi

  run_dir="$model_staging/sims/verilator/run_prog"
  read -r -a config_words <<< "$config_args"
  (cd "$run_dir" && ./configure.sh "${config_words[@]}")
  (cd "$run_dir" && make clean)
  PATH="$sim_path:$PATH" make -C "$run_dir" -j"$jobs" verilator \
    MYCPU_SRC="$model_staging/IP/myCPU" VERILATOR_HOME="$verilator_home"
  PATH="$sim_path:$PATH" make -C "$run_dir" -j"$jobs" testbench \
    MYCPU_SRC="$model_staging/IP/myCPU" VERILATOR_HOME="$verilator_home" \
    ALL_LIB="./obj_dir/*__ALL.a $extra_libs"
  model_sha=$(sha256sum "$run_dir/output" | awk '{print $1}')
  difftest_sha=$(sha256sum "$model_staging/sims/verilator/testbench/difftest.cpp" | awk '{print $1}')
  cat > "$model_staging/model-manifest.txt" <<EOF
format=nscscc-sim-model-v1
model_key=$model_key
platform_key=$platform_key
chiplab_commit=$chiplab_commit
profile=$profile
suite=$suite
rtl_sha256=$rtl_sha
config_args=$config_args
config_args_sha256=$config_args_sha
extra_libs_sha256=$extra_libs_sha
model_sha256=$model_sha
difftest_sha256=$difftest_sha
instrumentation_patch_sha256=$patch_sha
official_software_patch_sha256=$official_patch_sha
simulation_patch_sha256=$simulation_patch_sha
m01_patch_sha256=$m01_patch_sha
m01_source_manifest_sha256=$m01_source_sha
verilator_sha256=$verilator_sha
verilator=$verilator_version
verilator_home=$verilator_home
cxx_sha256=$cxx_sha
cxx=$cxx_version
EOF
  find -P "$model_staging" ! -type l -exec chmod a-w {} +
  replace_cache_entry "$model_staging" "$model_dir"
  tmp_dirs[-1]=
  printf 'Verilator model cache miss: %s\n' "$model_key"
else
  model_sha=$(manifest_value model_sha256 "$model_manifest")
  difftest_sha=$(manifest_value difftest_sha256 "$model_manifest")
  printf 'Verilator model cache hit: %s\n' "$model_key"
fi
flock -u "$model_lock_fd"

# Software artifacts have an independent identity.  Changing the requested
# workload set cannot silently reuse a model preparation that staged another set.
software_inputs=$(mktemp "$cache_root/.software-inputs.XXXXXX")
tmp_dirs+=("$software_inputs")
{
  printf 'format=nscscc-sim-software-v1\nplatform_key=%s\nsuite=%s\nworkloads=%s\nconfig_args_sha256=%s\n' \
    "$platform_key" "$suite" "$workloads" "$config_args_sha"
  case "$suite" in
    perf20)
      record_hash stage_script "$workspace/scripts/sim/stage-perf20"
      record_hash converter "$platform_dir/source/software/bsp/env/convert.c"
      host_cc_bin=$(command -v gcc)
      printf 'host_cc_sha256=%s\n' "$(sha256sum "$host_cc_bin" | awk '{print $1}')"
      printf 'host_cc=%s\n' "$(gcc --version | head -n 1)"
      for file in main.elf inst_data.bin test.s; do
        record_hash "perf20_$file" "$platform_dir/source/software/examples/nscscc_perf/obj/allbench/$file"
      done
      ;;
    func58)
      record_hash stage_script "$workspace/scripts/sim/stage-func58"
      for file in main.elf main.bin rom.vlog test.s; do
        record_hash "func58_$file" "$platform_dir/source/software/examples/nscscc_func/obj/$file"
      done
      ;;
    standard)
      printf 'standard_sources=%s\n' "$chiplab_commit"
      software_cc_bin=$(env PATH="$sim_path:$PATH" sh -c 'command -v loongarch32r-linux-gnusf-gcc')
      printf 'software_cc_sha256=%s\n' "$(sha256sum "$software_cc_bin" | awk '{print $1}')"
      printf 'software_cc=%s\n' "$(PATH="$sim_path:$PATH" loongarch32r-linux-gnusf-gcc --version | head -n 1)"
      ;;
  esac
} > "$software_inputs"
software_key=$(sha256sum "$software_inputs" | awk '{print $1}')
rm -f -- "$software_inputs"
tmp_dirs[-1]=
software_dir="$cache_root/software/$software_key"
software_manifest="$software_dir/software-manifest.txt"
software_checksums="$software_dir/software-files.sha256"
exec {software_lock_fd}>"$cache_root/locks/software-$software_key.lock"
flock "$software_lock_fd"
software_valid=0
if [[ -f $software_manifest && -f $software_checksums ]] &&
   [[ $(manifest_value format "$software_manifest") == nscscc-sim-software-v1 ]] &&
   [[ $(manifest_value software_key "$software_manifest") == "$software_key" ]] &&
   (cd "$software_dir" && sha256sum -c software-files.sha256 >/dev/null 2>&1); then
  software_valid=1
fi
if [[ $rebuild == 1 || $software_valid == 0 ]]; then
  software_staging=$(mktemp -d "$cache_root/software/.${software_key}.XXXXXX")
  tmp_dirs+=("$software_staging")
  mkdir -p "$software_staging/obj" "$software_staging/log"
  case "$suite" in
    perf20)
      "$workspace/scripts/sim/stage-perf20" \
        --chiplab-dir "$platform_dir/source" --run-dir "$software_staging" --workloads "$workloads"
      ;;
    func58)
      "$workspace/scripts/sim/stage-func58" \
        --chiplab-dir "$platform_dir/source" --run-dir "$software_staging" --workloads "$workloads"
      ;;
    standard)
      software_work=$(mktemp -d "$cache_root/software/.standard-work.XXXXXX")
      tmp_dirs+=("$software_work")
      cp -a --reflink=auto "$platform_dir/source/." "$software_work"
      chmod -R u+w "$software_work"
      export CHIPLAB_HOME="$software_work"
      standard_run_dir="$software_work/sims/verilator/run_prog"
      read -r -a config_words <<< "$config_args"
      (cd "$standard_run_dir" && ./configure.sh "${config_words[@]}")
      PATH="$sim_path:$PATH" make -C "$standard_run_dir" soft_compile
      if grep -Fxq 'TRACE_COMP=y' "$standard_run_dir/config-software.mak"; then
        chmod u+x "$standard_run_dir/qemu_system_run.sh"
        PATH="$sim_path:$PATH" make -C "$standard_run_dir" golden_trace
      fi
      cp -a "$standard_run_dir/obj/." "$software_staging/obj/"
      if [[ -d $standard_run_dir/log ]]; then
        cp -a "$standard_run_dir/log/." "$software_staging/log/"
      fi
      ;;
  esac
  IFS=',' read -r -a workload_list <<< "$workloads"
  for workload in "${workload_list[@]}"; do
    object_dir="$software_staging/obj/${workload}_obj/obj"
    if [[ ! -s $object_dir/rom.vlog ]]; then
      printf 'software cache did not produce %s\n' "$object_dir/rom.vlog" >&2
      exit 1
    fi
    if [[ $suite == standard && -f $software_work/sims/verilator/run_prog/config-software.mak ]] &&
       grep -Fxq 'TRACE_COMP=y' "$software_work/sims/verilator/run_prog/config-software.mak"; then
      golden="$software_staging/log/${workload}_log/golden_trace.txt"
      if [[ ! -s $golden ]]; then
        printf 'trace comparison requested but golden trace was not generated: %s\n' "$golden" >&2
        exit 1
      fi
    fi
  done
  cat > "$software_staging/software-manifest.txt" <<EOF
format=nscscc-sim-software-v1
software_key=$software_key
platform_key=$platform_key
chiplab_commit=$chiplab_commit
suite=$suite
workloads=$workloads
config_args_sha256=$config_args_sha
EOF
  (
    cd "$software_staging"
    find obj log -type f -print0 | sort -z | xargs -0 sha256sum > software-files.sha256
  )
  find -P "$software_staging" -exec chmod a-w {} +
  replace_cache_entry "$software_staging" "$software_dir"
  tmp_dirs[-1]=
  printf 'software cache miss: %s\n' "$software_key"
else
  printf 'software cache hit: %s\n' "$software_key"
fi
flock -u "$software_lock_fd"

variant=$profile
if [[ $suite != standard ]]; then
  variant="$profile-$suite"
fi
workload_key=$(printf 'suite=%s\nworkloads=%s\n' "$suite" "$workloads" | hash_stream)
prepared_root="$artifact_root/prepared/cpu_${cpu_short}_chiplab_${chiplab_commit:0:12}"
target="$prepared_root/${variant}_workloads_${workload_key:0:12}"
mkdir -p "$prepared_root"
prepared_staging=$(mktemp -d "$prepared_root/.${variant}.XXXXXX")
tmp_dirs+=("$prepared_staging")
ln -s "$model_dir" "$prepared_staging/model"
ln -s "$software_dir" "$prepared_staging/software"
git -C "$workspace" status --short -- cpu > "$prepared_staging/cpu-status.txt"
git -C "$workspace" diff --binary -- cpu > "$prepared_staging/cpu-dirty.patch"
git -C "$chiplab_dir" status --short > "$prepared_staging/chiplab-status.txt"
git -C "$chiplab_dir" diff --binary > "$prepared_staging/chiplab-dirty.patch"
cat > "$prepared_staging/sim-prepared-manifest.txt" <<EOF
format=nscscc-sim-prepared-v3
profile=$profile
suite=$suite
root_commit=$root_commit
cpu_commit=$root_commit
cpu_source_sha256=$cpu_source_sha
chiplab_commit=$chiplab_commit
workloads=$workloads
workload_key=$workload_key
config_args=$config_args
platform_key=$platform_key
model_key=$model_key
software_key=$software_key
cpu_dirty_patch_sha256=$(sha256sum "$prepared_staging/cpu-dirty.patch" | awk '{print $1}')
chiplab_dirty_patch_sha256=$(sha256sum "$prepared_staging/chiplab-dirty.patch" | awk '{print $1}')
rtl_sha256=$rtl_sha
model_sha256=$model_sha
difftest_sha256=$difftest_sha
instrumentation_patch_sha256=$patch_sha
official_software_patch_sha256=$official_patch_sha
simulation_patch_sha256=$simulation_patch_sha
m01_patch_sha256=$m01_patch_sha
m01_source_manifest_sha256=$m01_source_sha
verilator=$verilator_version
java=$(java -version 2>&1 | head -n 1)
EOF
replace_cache_entry "$prepared_staging" "$target"
tmp_dirs[-1]=
trap - EXIT
printf 'prepared simulation request: %s\n' "$target"
printf 'model: %s\nsoftware: %s\nmanifest: %s\n' \
  "$model_dir" "$software_dir" "$target/sim-prepared-manifest.txt"
