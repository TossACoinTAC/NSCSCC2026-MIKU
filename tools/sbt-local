#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
cache_root=${NSCSCC_SBT_CACHE_ROOT:-$workspace_root/tools/.local/sbt}
runtime_dir=${NSCSCC_SBT_RUNTIME_DIR:-/tmp/nscscc-sbt-runtime}
launcher=${NSCSCC_SBT_LAUNCHER:-$cache_root/sbt-launch.jar}
tool_bin=$script_dir/bin
expected_launcher_sha256=e988d533a020e5b60ec22c3b5df4cd3e3df465f4fdc3951c63036e21483978e4

mkdir -p "$cache_root/boot" "$cache_root/coursier" "$cache_root/global" \
    "$cache_root/home" "$cache_root/ivy2" "$runtime_dir"

batch_arg=
if [ "${1:-}" = -batch ]; then
    batch_arg=-batch
    shift
fi

if [ -f "$launcher" ]; then
    actual_launcher_sha256=$(sha256sum "$launcher" | awk '{print $1}')
    if [ "$actual_launcher_sha256" != "$expected_launcher_sha256" ]; then
        printf 'unexpected SBT launcher hash: expected %s, found %s\n' \
            "$expected_launcher_sha256" "$actual_launcher_sha256" >&2
        exit 1
    fi
    exec env -u VERILATOR_ROOT HOME="$cache_root/home" XDG_RUNTIME_DIR="$runtime_dir" \
        COURSIER_CACHE="$cache_root/coursier" \
        PATH="$tool_bin:$PATH" \
        java \
        -Dsbt.boot.directory="$cache_root/boot" \
        -Dsbt.global.base="$cache_root/global" \
        -Dsbt.ivy.home="$cache_root/ivy2" \
        -jar "$launcher" "$@"
fi

printf 'locked SBT launcher is missing: %s\n' "$launcher" >&2
printf 'restore the validated tools/.local cache before running CPU gates\n' >&2
exit 127
