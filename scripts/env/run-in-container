#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace_root=${WORKSPACE_ROOT:-$(CDPATH= cd -- "$script_dir/../.." && pwd)}
image=${DOCKER_IMAGE:-nscscc-dev:ubuntu24.04-v1}
cache_volume=${DOCKER_CACHE_VOLUME:-nscscc-sbt-cache-v1}
workdir=${CONTAINER_WORKDIR:-$workspace_root}

[ "$#" -gt 0 ] || {
  printf 'usage: %s command [argument ...]\n' "$0" >&2
  exit 2
}

command -v docker >/dev/null 2>&1 || {
  printf 'docker 不可用；请先运行 make doctor 并修复环境配置\n' >&2
  exit 127
}

docker info >/dev/null 2>&1 || {
  printf 'docker daemon 不可用；请先运行 make doctor 并修复环境配置\n' >&2
  exit 125
}

host_uid=$(id -u)
host_gid=$(id -g)
docker run --rm --user 0 -v "$cache_volume:/cache" "$image" sh -ec \
  'mkdir -p /cache/sbt /cache/ivy; chown "$1:$2" /cache /cache/sbt /cache/ivy' sh \
  "$host_uid" "$host_gid"

exec docker run --rm -i \
  --user "$host_uid:$host_gid" \
  -e HOME=/tmp \
  -e COURSIER_CACHE=/cache/coursier \
  -e SPINAL_SIM_WORKSPACE_ROOT="${SPINAL_SIM_WORKSPACE_ROOT:-$workspace_root/cpu/target/spinal-sim/workspaces}" \
  -e SPINAL_SIM_WORKSPACE="${SPINAL_SIM_WORKSPACE:-$workspace_root/cpu/target/spinal-sim/contracts}" \
  -v "$workspace_root:$workspace_root" \
  -v "$cache_volume:/cache" \
  -w "$workdir" \
  "$image" "$@"
