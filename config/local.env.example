# 复制为 config/local.env 后按本机修改。此文件只描述路径和机器容量，不锁版本。
WORKSPACE_ROOT ?= /home/user/WorkSpace/NSCSCC2026
VIVADO_HOME ?= /opt/Xilinx/Vivado/2023.2
VIVADO ?= $(VIVADO_HOME)/bin/vivado
SURFER ?= /mnt/d/Surfer/surfer.exe
JAVA_HOME ?=
DOCKER_IMAGE ?= nscscc-dev:ubuntu24.04-v1
CHIPLAB_HOME ?= $(WORKSPACE_ROOT)/chiplab
CHIPLAB_TOOLCHAINS ?= $(CHIPLAB_HOME)/toolchains
LINUX_KERNEL_DIR ?= $(WORKSPACE_ROOT)/nscscc-linux-kernel
LABAGENT_DIR ?= $(WORKSPACE_ROOT)/fpga-lab-agent
VIVADO_BUILD_ROOT ?= $(WORKSPACE_ROOT)/build/vivado
SIM_LANES ?= 2
JOBS ?= 8
