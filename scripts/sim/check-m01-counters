#!/usr/bin/env python3
import json
import sys
from pathlib import Path


def fail(message: str) -> None:
    print(f"M01 counter check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) != 2:
    fail("usage: check-m01-counters FILE")

path = Path(sys.argv[1])
try:
    counters = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as error:
    fail(str(error))

schema = counters.get("schema_version")
if schema == "miku-perf-observation-v1":
    abi = counters.get("observation_abi")
    if abi != {"magic": "MIKU", "version": 1, "word_count": 8}:
        fail(f"unexpected observation ABI {abi!r}")
    if counters.get("commit_observation_lag_cycles") != 4:
        fail("unexpected DiffTest commit observation lag")

    hist = counters.get("retire_width_histogram")
    if not isinstance(hist, list) or len(hist) != 4 or not all(
        isinstance(value, int) and value >= 0 for value in hist
    ):
        fail("retire_width_histogram must contain four nonnegative integers")
    cycles = counters.get("cycles")
    instructions = counters.get("retired_instructions")
    observed = counters.get("observed_commit_instructions")
    if not isinstance(cycles, int) or cycles < 0:
        fail("cycles must be a nonnegative integer")
    if sum(hist) != cycles:
        fail("retire histogram does not conserve cycles")
    weighted = sum(width * count for width, count in enumerate(hist))
    if weighted != instructions or observed != instructions:
        fail("retire histogram and DiffTest commit stream do not conserve instructions")
    if counters.get("unused_commit_slots") != 3 * cycles - instructions:
        fail("unused_commit_slots does not conserve commit width")

    zero = counters.get("zero_retire_loss", {})
    if set(zero) != {"recovery", "rob_empty", "rob_nonempty"} or not all(
        isinstance(value, int) and value >= 0 for value in zero.values()
    ):
        fail("zero_retire_loss has an invalid schema")
    if sum(zero.values()) != hist[0]:
        fail("zero-retire causes do not conserve zero-width cycles")

    rob = counters.get("rob", {})
    rob_hist = rob.get("occupancy_histogram")
    if not isinstance(rob_hist, list) or len(rob_hist) != 33 or not all(
        isinstance(value, int) and value >= 0 for value in rob_hist
    ):
        fail("ROB occupancy histogram must contain 33 nonnegative integers")
    if sum(rob_hist) != cycles:
        fail("ROB occupancy histogram does not conserve cycles")
    if rob.get("occupancy_sum") != sum(index * value for index, value in enumerate(rob_hist)):
        fail("ROB occupancy sum does not match its histogram")
    if rob.get("occupancy_max") != max((index for index, value in enumerate(rob_hist) if value), default=0):
        fail("ROB occupancy max does not match its histogram")
    if rob.get("full_cycles") != rob_hist[32]:
        fail("ROB full cycles do not match occupancy bin 32")

    frontend = counters.get("frontend", {})
    frontend_hist = frontend.get("occupancy_histogram")
    if not isinstance(frontend_hist, list) or len(frontend_hist) != 17 or not all(
        isinstance(value, int) and value >= 0 for value in frontend_hist
    ):
        fail("frontend occupancy histogram must contain 17 nonnegative integers")
    if sum(frontend_hist) != cycles:
        fail("frontend occupancy histogram does not conserve cycles")
    frontend_intervals = frontend.get("request_interval_histogram")
    if not isinstance(frontend_intervals, list) or len(frontend_intervals) != 8 or not all(
        isinstance(value, int) and value >= 0 for value in frontend_intervals
    ):
        fail("frontend request interval histogram must contain eight nonnegative integers")
    request_fire = frontend.get("cache_request_fire")
    if sum(frontend_intervals) != max(request_fire - 1, 0):
        fail("frontend request intervals do not conserve request fires")

    issue = counters.get("issue", {})
    for name in ("ready_cycles", "ready_entries", "occupancy_sum", "full_cycles", "fire_by_port"):
        values = issue.get(name)
        if not isinstance(values, list) or len(values) != 4 or not all(
            isinstance(value, int) and value >= 0 for value in values
        ):
            fail(f"issue {name} must contain four nonnegative integers")
    if any(value > cycles for value in issue["ready_cycles"] + issue["full_cycles"]):
        fail("issue cycle count exceeds observation cycles")
    if any(value > 8 * cycles for value in issue["ready_entries"] + issue["occupancy_sum"]):
        fail("issue entry sum exceeds queue capacity")
    if issue.get("fire_sum") > issue.get("operand_valid_sum"):
        fail("issue fire count exceeds valid operand count")
    if sum(issue["fire_by_port"]) != issue.get("fire_sum"):
        fail("issue fire_by_port does not conserve fire_sum")

    dispatch = counters.get("dispatch", {})
    dispatch_hist = dispatch.get("fire_histogram")
    if not isinstance(dispatch_hist, list) or len(dispatch_hist) != 5 or not all(
        isinstance(value, int) and value >= 0 for value in dispatch_hist
    ):
        fail("dispatch fire histogram must contain five nonnegative integers")
    if sum(dispatch_hist) != cycles:
        fail("dispatch fire histogram does not conserve cycles")
    if sum(width * count for width, count in enumerate(dispatch_hist)) != dispatch.get("fire_sum"):
        fail("dispatch fire histogram does not conserve accepted uops")
    if dispatch.get("fire_sum") > dispatch.get("valid_sum"):
        fail("dispatch fire count exceeds valid input count")

    branch = counters.get("branch", {})
    branch_hist = branch.get("commit_histogram")
    if not isinstance(branch_hist, list) or len(branch_hist) != 4 or sum(branch_hist) != cycles:
        fail("branch commit histogram does not conserve cycles")
    if sum(width * count for width, count in enumerate(branch_hist)) != branch.get("retired"):
        fail("branch commit histogram does not conserve branches")
    resolved = branch.get("resolved")
    mispredicted = branch.get("mispredicted")
    matches = branch.get("recovery_matches")
    unmatched = branch.get("recovery_without_resolution")
    if not all(isinstance(value, int) and value >= 0 for value in (resolved, mispredicted, matches, unmatched)):
        fail("branch counts must be nonnegative integers")
    if matches > mispredicted or mispredicted > resolved:
        fail("branch resolve/recovery counts violate containment")
    latency_hist = branch.get("resolve_to_recovery_histogram")
    if not isinstance(latency_hist, list) or len(latency_hist) != 8 or sum(latency_hist) != matches:
        fail("branch recovery latency histogram does not conserve matches")
    branch_recoveries = counters.get("recovery_cause", {}).get("branch_mispredict")
    if matches + unmatched != branch_recoveries:
        fail("branch recovery matching does not conserve branch recoveries")

    lsq = counters.get("lsq", {})
    lsq_events = lsq.get("events")
    if not isinstance(lsq_events, list) or len(lsq_events) != 28 or not all(
        isinstance(value, int) and 0 <= value <= cycles for value in lsq_events
    ):
        fail("LSQ events must contain 28 per-cycle counters")
    if lsq.get("load_occupancy_sum", -1) > 16 * cycles:
        fail("load queue occupancy exceeds capacity")
    if lsq.get("store_occupancy_sum", -1) > 8 * cycles:
        fail("store queue occupancy exceeds capacity")

    cache = counters.get("cache", {})
    if not isinstance(cache.get("events"), list) or len(cache["events"]) != 20:
        fail("cache events must contain 20 counters")
    if not isinstance(cache.get("occupancy_sum"), list) or len(cache["occupancy_sum"]) != 3:
        fail("cache occupancy_sum must contain three counters")

    axi = counters.get("axi", {})
    for name in ("valid", "fire", "backpressure"):
        values = axi.get(name)
        if not isinstance(values, list) or len(values) != 5 or not all(
            isinstance(value, int) and 0 <= value <= cycles for value in values
        ):
            fail(f"AXI {name} must contain five per-cycle counters")
    if not isinstance(axi.get("errors"), list) or len(axi["errors"]) != 2:
        fail("AXI errors must contain read and write counters")
    if any(fire > valid for fire, valid in zip(axi["fire"], axi["valid"])):
        fail("AXI fire count exceeds valid count")

    invariants = counters.get("invariants", {})
    for name in (
        "abi_valid", "retire_hist_cycles", "retire_hist_instructions",
        "commit_observation", "source_retire_alignment",
    ):
        if invariants.get(name) is not True:
            fail(f"invariant {name} is not true")
    for name in (
        "abi_errors", "source_retire_alignment_errors",
        "sampling_protocol_errors", "non_prefix_retire_cycles",
    ):
        if invariants.get(name) != 0:
            fail(f"invariant counter {name} is nonzero")

    print(
        f"PerfObservationV1 counters pass: cycles={cycles} instructions={instructions} "
        f"ipc={instructions / cycles if cycles else 0:.6f} "
        f"trace={counters.get('commit_trace_signature_fnv1a64')}"
    )
    raise SystemExit(0)

if schema not in {"nscc-m01-v6", "nscc-m01-v7", "nscc-m01-v8"}:
    fail(f"unexpected schema {schema!r}")
if counters.get("commit_observation_lag_cycles") != 4:
    fail("unexpected DiffTest commit observation lag")

hist = counters.get("retire_width_histogram")
if not isinstance(hist, list) or len(hist) != 4 or not all(isinstance(value, int) and value >= 0 for value in hist):
    fail("retire_width_histogram must contain four nonnegative integers")

cycles = counters.get("cycles")
instructions = counters.get("retired_instructions")
observed = counters.get("observed_commit_instructions")
if sum(hist) != cycles:
    fail(f"retire histogram sums to {sum(hist)}, cycles is {cycles}")
weighted = sum(width * count for width, count in enumerate(hist))
if weighted != instructions:
    fail(f"retire histogram represents {weighted} instructions, counter is {instructions}")
if observed != instructions:
    fail(f"difftest observed {observed} instructions, sampled {instructions}")
if counters.get("unused_commit_slots") != 3 * cycles - instructions:
    fail("unused_commit_slots does not conserve commit width")

dispatch = counters.get("dispatch", {})
d01_candidates = dispatch.get("d01_oldest_load_candidate_cycles")
d01_blocked = dispatch.get("d01_oldest_load_blocked_by_sdq_cycles")
if not isinstance(d01_candidates, int) or d01_candidates < 0:
    fail("D01 candidate cycles must be a nonnegative integer")
if not isinstance(d01_blocked, int) or d01_blocked < 0:
    fail("D01 SDQ-blocked cycles must be a nonnegative integer")
if d01_blocked > d01_candidates:
    fail("D01 SDQ-blocked cycles exceed oldest-Load candidate cycles")

if schema in {"nscc-m01-v7", "nscc-m01-v8"}:
    frontend = counters.get("frontend", {})
    frontend_occupancy = frontend.get("occupancy_histogram")
    expected_occupancy_bins = 17 if schema == "nscc-m01-v8" else 9
    if not isinstance(frontend_occupancy, list) or len(frontend_occupancy) != expected_occupancy_bins or not all(
        isinstance(value, int) and value >= 0 for value in frontend_occupancy
    ):
        fail(
            "frontend occupancy histogram must contain "
            f"{expected_occupancy_bins} nonnegative integers"
        )
    if sum(frontend_occupancy) != cycles:
        fail("frontend occupancy histogram does not conserve cycles")
    request_fire = frontend.get("cache_request_fire")
    request_intervals = frontend.get("request_interval_histogram")
    if not isinstance(request_fire, int) or request_fire < 0:
        fail("frontend cache request fire count is invalid")
    if not isinstance(request_intervals, list) or len(request_intervals) != 8 or not all(
        isinstance(value, int) and value >= 0 for value in request_intervals
    ):
        fail("frontend request interval histogram must contain eight nonnegative integers")
    if sum(request_intervals) != max(request_fire - 1, 0):
        fail("frontend request interval histogram does not conserve request fires")
    for name in (
        "translation_request_fire", "translation_outstanding_cycles",
        "translated_request_valid_cycles", "cache_request_base_valid_cycles",
        "cache_response_fire", "cache_outstanding_cycles",
    ):
        value = frontend.get(name)
        if not isinstance(value, int) or value < 0:
            fail(f"frontend {name} must be a nonnegative integer")

    issue = counters.get("issue", {})
    for name in ("occupancy_sum", "full_cycles", "fire_by_port"):
        values = issue.get(name)
        if not isinstance(values, list) or len(values) != 4 or not all(
            isinstance(value, int) and value >= 0 for value in values
        ):
            fail(f"issue {name} must contain four nonnegative integers")
    if any(value > cycles for value in issue["full_cycles"]):
        fail("issue full cycles exceed observation cycles")
    if any(value > 8 * cycles for value in issue["occupancy_sum"]):
        fail("issue occupancy sum exceeds eight entries per cycle")
    issue_valid = issue.get("operand_valid_sum")
    issue_fire = issue.get("fire_sum")
    if not isinstance(issue_valid, int) or not isinstance(issue_fire, int):
        fail("issue valid/fire sums must be integers")
    if issue_fire > issue_valid or sum(issue["fire_by_port"]) != issue_fire:
        fail("issue fire counts do not conserve accepted issue slots")

    dispatch_fire = dispatch.get("fire_sum")
    dispatch_valid = dispatch.get("valid_sum")
    dispatch_hist = dispatch.get("fire_histogram")
    if not isinstance(dispatch_hist, list) or len(dispatch_hist) != 4 or not all(
        isinstance(value, int) and value >= 0 for value in dispatch_hist
    ):
        fail("dispatch fire histogram must contain four nonnegative integers")
    if sum(dispatch_hist) != cycles:
        fail("dispatch fire histogram does not conserve cycles")
    if sum(width * count for width, count in enumerate(dispatch_hist)) != dispatch_fire:
        fail("dispatch fire histogram does not conserve accepted uops")
    if not isinstance(dispatch_valid, int) or dispatch_fire > dispatch_valid:
        fail("dispatch fire count exceeds valid input count")

    branch = counters.get("branch", {})
    branch_hist = branch.get("commit_histogram")
    if not isinstance(branch_hist, list) or len(branch_hist) != 4 or not all(
        isinstance(value, int) and value >= 0 for value in branch_hist
    ):
        fail("branch commit histogram must contain four nonnegative integers")
    if sum(branch_hist) != cycles:
        fail("branch commit histogram does not conserve cycles")
    if sum(width * count for width, count in enumerate(branch_hist)) != branch.get("retired"):
        fail("branch commit histogram does not conserve retired branches")
    if branch_hist[2] + branch_hist[3] != branch.get("multi_commit_cycles"):
        fail("branch multi-commit cycles do not match commit histogram")
    predictor_updates = branch.get("predictor_update_cycles")
    if not isinstance(predictor_updates, int) or predictor_updates < 0:
        fail("predictor update cycles must be a nonnegative integer")
    if predictor_updates > branch.get("retired"):
        fail("predictor update cycles exceed retired branches")
    resolved = branch.get("resolved")
    mispredicted = branch.get("mispredicted")
    matches = branch.get("recovery_matches")
    unmatched = branch.get("recovery_without_resolution")
    if not all(isinstance(value, int) and value >= 0 for value in (resolved, mispredicted, matches, unmatched)):
        fail("branch resolve/recovery counts must be nonnegative integers")
    if matches > mispredicted or mispredicted > resolved:
        fail("branch resolve/recovery counts violate containment")
    branch_latency_hist = branch.get("resolve_to_recovery_histogram")
    if not isinstance(branch_latency_hist, list) or len(branch_latency_hist) != 8 or not all(
        isinstance(value, int) and value >= 0 for value in branch_latency_hist
    ):
        fail("branch resolve-to-recovery histogram must contain eight nonnegative integers")
    if sum(branch_latency_hist) != matches:
        fail("branch resolve-to-recovery histogram does not conserve matching recoveries")
    branch_recoveries = counters.get("recovery_cause", {}).get("branch_mispredict")
    if matches + unmatched != branch_recoveries:
        fail("branch recovery matching does not conserve branch recoveries")

e02 = counters.get("e02", {})
e02_cycles = e02.get("head_staged_cycles")
e02_lanes = e02.get("by_lane")
e02_classes = e02.get("by_class", {})
e02_class_names = {
    "load", "store", "branch", "multiplier",
    "lane0_other", "lane1_other", "lane2_other", "lane3_other",
}
if not isinstance(e02_cycles, int) or e02_cycles < 0:
    fail("E02 head-staged cycles must be a nonnegative integer")
if not isinstance(e02_lanes, list) or len(e02_lanes) != 5 or not all(
    isinstance(value, int) and value >= 0 for value in e02_lanes
):
    fail("E02 lane counts must contain five nonnegative integers")
if sum(e02_lanes) != e02_cycles:
    fail("E02 lane counts do not conserve head-staged cycles")
if not isinstance(e02_classes, dict) or set(e02_classes) != e02_class_names or not all(
    isinstance(value, int) and value >= 0 for value in e02_classes.values()
):
    fail("E02 class counts must contain eight nonnegative integers")
if sum(e02_classes.values()) != e02_cycles:
    fail("E02 class counts do not conserve head-staged cycles")

w01 = counters.get("w01", {})
w01_conflicts = w01.get("conflict_cycles_by_lane")
w01_affected = w01.get("affected_cycles_by_lane")
w01_consumers = w01.get("affected_consumer_entries_by_lane")
for name, values in (
    ("conflict", w01_conflicts),
    ("affected", w01_affected),
    ("affected consumer", w01_consumers),
):
    if not isinstance(values, list) or len(values) != 3 or not all(
        isinstance(value, int) and value >= 0 for value in values
    ):
        fail(f"W01 {name} counts must contain three nonnegative integers")
for lane in range(3):
    if w01_affected[lane] > w01_conflicts[lane]:
        fail(f"W01 lane {lane} affected cycles exceed conflict cycles")
    if w01_consumers[lane] < w01_affected[lane]:
        fail(f"W01 lane {lane} affected consumer entries are below affected cycles")

l05 = counters.get("l05", {})
l05_mode_names = {"direct", "dmw0", "dmw1", "tlb"}
l05_maps = {}
for field in ("requests_by_mode", "responses_by_mode", "response_latency_cycles_by_mode"):
    values = l05.get(field)
    if not isinstance(values, dict) or set(values) != l05_mode_names:
        fail(f"L05 {field} must contain direct, dmw0, dmw1, and tlb")
    if not all(
        isinstance(pair, list) and len(pair) == 2 and
        all(isinstance(value, int) and value >= 0 for value in pair)
        for pair in values.values()
    ):
        fail(f"L05 {field} entries must be nonnegative [load, store] pairs")
    l05_maps[field] = values
for mode in l05_mode_names:
    for owner in range(2):
        if l05_maps["responses_by_mode"][mode][owner] > l05_maps["requests_by_mode"][mode][owner]:
            fail(f"L05 {mode} owner {owner} responses exceed requests")
l05_blocks = l05.get("direct_dmw_store_blocked_load_cycles")
if not isinstance(l05_blocks, dict) or set(l05_blocks) != {"direct", "dmw0", "dmw1"} or not all(
    isinstance(value, int) and value >= 0 for value in l05_blocks.values()
):
    fail("L05 direct/DMW Store block counts are invalid")
if not isinstance(l05.get("boundary_responses"), int) or l05["boundary_responses"] < 0:
    fail("L05 boundary response count is invalid")
if l05.get("protocol_errors") != 0:
    fail("L05 observed overlapping translation ownership")
if not isinstance(l05.get("pending_at_end"), bool):
    fail("L05 pending_at_end must be boolean")

w02 = counters.get("w02", {})
w02_completions = w02.get("load_completions")
w02_affected = w02.get("affected_cycles")
w02_safe = w02.get("safe_p0_p2_affected_cycles")
w02_cycles_by_queue = w02.get("affected_cycles_by_queue")
w02_consumers_by_queue = w02.get("affected_consumer_entries_by_queue")
for name, value in (("load completions", w02_completions), ("affected cycles", w02_affected),
                    ("safe affected cycles", w02_safe)):
    if not isinstance(value, int) or value < 0:
        fail(f"W02 {name} must be a nonnegative integer")
if w02_affected > w02_completions or w02_safe > w02_affected:
    fail("W02 affected cycles exceed their parent count")
for name, values in (("affected cycles by queue", w02_cycles_by_queue),
                     ("affected consumers by queue", w02_consumers_by_queue)):
    if not isinstance(values, list) or len(values) != 4 or not all(
        isinstance(value, int) and value >= 0 for value in values
    ):
        fail(f"W02 {name} must contain four nonnegative integers")
for queue in range(4):
    if w02_cycles_by_queue[queue] > w02_completions:
        fail(f"W02 queue {queue} affected cycles exceed load completions")
    if w02_consumers_by_queue[queue] < w02_cycles_by_queue[queue]:
        fail(f"W02 queue {queue} consumer entries are below affected cycles")

invariants = counters.get("invariants", {})
for name in ("retire_hist_cycles", "retire_hist_instructions", "commit_observation", "source_retire_alignment", "queue_identity"):
    if invariants.get(name) is not True:
        fail(f"invariant {name} is not true")
if invariants.get("non_prefix_retire_cycles") != 0:
    fail("non-prefix retire mask observed")
if invariants.get("sampling_protocol_errors") != 0:
    fail("monitor/DPI cycle alignment protocol failed")
if invariants.get("source_retire_alignment_errors") != 0:
    fail("source snapshot retired width differs from its DiffTest commit packet")
if invariants.get("queue_identity_mismatches") != 0:
    fail("ROB head payload does not identify a matching LQ/SQ entry")
zero = counters.get("zero_retire_loss", {})
zero_total = sum(zero.get(name, 0) for name in (
    "recovery", "rob_empty", "head_incomplete", "head_complete_blocked", "unclassified"
))
if zero_total != hist[0]:
    fail(f"zero-retire causes sum to {zero_total}, histogram is {hist[0]}")
if e02_cycles > zero.get("head_incomplete", 0):
    fail("E02 head-staged cycles exceed the head-incomplete parent bucket")

head_incomplete = counters.get("head_incomplete_detail", {})
if sum(head_incomplete.values()) != zero.get("head_incomplete"):
    fail("head-incomplete detail does not conserve its parent loss bucket")
if sum(counters.get("store_translation_detail", {}).values()) != head_incomplete.get("store_translation"):
    fail("store-translation detail does not conserve its parent bucket")
if sum(counters.get("store_completion_detail", {}).values()) != head_incomplete.get("store_completion_to_rob"):
    fail("store-completion detail does not conserve its parent bucket")
head_complete = counters.get("head_complete_blocked_detail", {})
if sum(head_complete.values()) != zero.get("head_complete_blocked"):
    fail("head-complete-blocked detail does not conserve its parent loss bucket")

print(
    f"M01 counters pass: cycles={cycles} instructions={instructions} "
    f"ipc={instructions / cycles if cycles else 0:.6f} "
    f"trace={counters.get('commit_trace_signature_fnv1a64')}"
)
