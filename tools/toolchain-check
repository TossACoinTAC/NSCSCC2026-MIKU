#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

"$script_dir/verilator-local" --version
(cd "$workspace_root/nscscc-cpu/spinal" && "$script_dir/sbt-local" -batch sbtVersion)
"$script_dir/glab-local" --version
docker image inspect nscscc-local-gates:ubuntu24.04-v1 >/dev/null
printf 'toolchain lock: %s\n' "$workspace_root/tools/toolchain.lock"
