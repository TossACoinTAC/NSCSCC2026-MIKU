#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: stage-func58-software --chiplab-dir DIR --run-dir DIR --workloads func58'
}

chiplab_dir=
run_dir=
workloads=
while (($#)); do
  case "$1" in
    --chiplab-dir) chiplab_dir=$2; shift 2 ;;
    --run-dir) run_dir=$2; shift 2 ;;
    --workloads) workloads=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

for value in chiplab_dir run_dir workloads; do
  if [[ -z ${!value} ]]; then
    printf 'missing required value: %s\n' "$value" >&2
    exit 2
  fi
done
if [[ $workloads != func58 ]]; then
  printf 'func58 suite requires exactly SIM_WORKLOADS=func58, got %s\n' "$workloads" >&2
  exit 2
fi

source_dir="$chiplab_dir/software/examples/nscscc_func/obj"
object_dir="$run_dir/obj/func58_obj/obj"
for file in main.elf main.bin rom.vlog test.s; do
  if [[ ! -f $source_dir/$file ]]; then
    printf 'locked func58 artifact missing: %s\n' "$source_dir/$file" >&2
    exit 1
  fi
done
mkdir -p "$object_dir"
install -m 0444 "$source_dir/main.elf" "$object_dir/main.elf"
install -m 0444 "$source_dir/main.bin" "$object_dir/main.bin"
install -m 0444 "$source_dir/rom.vlog" "$object_dir/rom.vlog"
install -m 0444 "$source_dir/test.s" "$object_dir/test.s"
