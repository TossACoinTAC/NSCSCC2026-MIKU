#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
prefix=${NSCSCC_GLAB_PREFIX:-$script_dir/.local/glab/1.111.0}
binary=$prefix/bin/glab
expected_sha256=3f9e22239dcdc64a89e2d6fa40cb2e7adcfbfa04e0785195836150b302a7e70f

if [ ! -x "$binary" ]; then
    printf 'locked glab 1.111.0 is missing below %s\n' "$prefix" >&2
    printf 'restore the validated tools/.local cache before accessing official CI\n' >&2
    exit 127
fi

actual_sha256=$(sha256sum "$binary" | awk '{print $1}')
if [ "$actual_sha256" != "$expected_sha256" ]; then
    printf 'unexpected glab hash: expected %s, found %s\n' \
        "$expected_sha256" "$actual_sha256" >&2
    exit 1
fi

export XDG_CONFIG_HOME=${NSCSCC_GLAB_CONFIG_HOME:-$prefix/config}
exec "$binary" "$@"
