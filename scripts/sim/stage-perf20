#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: stage-perf20-software --chiplab-dir DIR --run-dir DIR --workloads CSV'
}

chiplab_dir=
run_dir=
workloads=
while (($#)); do
  case "$1" in
    --chiplab-dir) chiplab_dir=$2; shift 2 ;;
    --run-dir) run_dir=$2; shift 2 ;;
    --workloads) workloads=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

for value in chiplab_dir run_dir workloads; do
  if [[ -z ${!value} ]]; then
    printf 'missing required value: %s\n' "$value" >&2
    exit 2
  fi
done

valid_benchmarks=' bitcount bubble_sort coremark crc32 dhrystone quick_sort select_sort sha stream_copy stringsearch fireye_A0 fireye_B2 fireye_C0 fireye_D1 fireye_I2 inner_product lookup_table loop_induction my_memcmp minmax_sequence '
source_dir="$chiplab_dir/software/examples/nscscc_perf/obj/allbench"
for file in main.elf inst_data.bin test.s; do
  if [[ ! -f $source_dir/$file ]]; then
    printf 'locked perf20 allbench artifact missing: %s\n' "$source_dir/$file" >&2
    exit 1
  fi
done
converter_dir=$(mktemp -d /tmp/nscc-perf20-convert.XXXXXX)
cleanup() {
  rm -rf -- "$converter_dir"
}
trap cleanup EXIT
gcc -O2 -o "$converter_dir/convert" "$chiplab_dir/software/bsp/env/convert.c"

IFS=',' read -r -a workload_list <<< "$workloads"
for workload in "${workload_list[@]}"; do
  if [[ $workload != perf20/* ]]; then
    printf 'perf20 workload must use perf20/<benchmark>, got %s\n' "$workload" >&2
    exit 2
  fi
  benchmark=${workload#perf20/}
  if [[ $valid_benchmarks != *" $benchmark "* ]]; then
    printf 'unknown perf20 benchmark: %s\n' "$benchmark" >&2
    exit 2
  fi
  object_dir="$run_dir/obj/${workload}_obj/obj"
  mkdir -p "$object_dir"
  install -m 0444 "$source_dir/main.elf" "$object_dir/main.elf"
  install -m 0444 "$source_dir/inst_data.bin" "$object_dir/inst_data.bin"
  install -m 0444 "$source_dir/test.s" "$object_dir/test.s"
  "$converter_dir/convert" inst_data.bin "$object_dir/"
done
